GOOGLE_GEMINI_KEY=your_gemini_api_key_here
# Comma-separated frontend URLs allowed to call the API (default: Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173
# Max review requests per IP every 15 minutes
RATE_LIMIT_MAX=20
# Max reviews per day across all users (protects Gemini quota)
DAILY_REVIEW_LIMIT=500
# Max characters of code per review
MAX_CODE_CHARS=20000
# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-code-correction
# Long random string used to sign login tokens, e.g. output of:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# How long a login lasts
JWT_EXPIRES_IN=7d
# Max failed login/register attempts per IP every 15 minutes
AUTH_RATE_LIMIT_MAX=10
