GOOGLE_GEMINI_KEY=your_gemini_api_key_here
# Comma-separated frontend URLs allowed to call the API (default: Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173
# Max review requests per IP every 15 minutes
RATE_LIMIT_MAX=20
# Max reviews per day across all users (protects Gemini quota)
DAILY_REVIEW_LIMIT=500
# Max characters of code per review
MAX_CODE_CHARS=20000
